# Copy to .env.local and fill in. Never commit .env.local.
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase database (Supabase dashboard > Connect > ORMs > Prisma).
# DATABASE_URL: the pooled "Transaction" connection (port 6543), used by the running app.
# DIRECT_URL: the "Session" or direct connection (port 5432), used by the Prisma CLI.
# Replace [YOUR-PASSWORD] with the database password. On Vercel set both as environment variables.
DATABASE_URL=
DIRECT_URL=

# Optional, only for `npm test` to run lib/db/planner-repo.db.test.ts.
# Must be a THROWAWAY database with the same tables; the test adds rows. Never the real one.
# TEST_DATABASE_URL=
